// ================= 配置区 =================
// 国内 DNS（DoH）
const domesticNameservers = [
  "https://223.5.5.5/dns-query",
  "https://doh.pub/dns-query"
];

// 国外 DNS（DoH）
const foreignNameservers = [
  "https://1.1.1.1/dns-query",
  "https://8.8.8.8/dns-query",
  "https://dns.google/dns-query"
];

// 规则集通用配置
const ruleProviderCommon = {
  type: "http",
  format: "yaml",
  interval: 86400,
  behavior: "domain"
};

// ================= 主逻辑 =================
function main(config) {

  // ===== 1. 基础性能 & 指纹 =====
  config["tcp-concurrent"] = true;
  config["unified-delay"] = true;
  config["global-client-fingerprint"] = "chrome";

  // ===== 2. TUN 配置（关键：DNS 接管）=====
  config["tun"] = {
    enable: true,
    stack: "system",                 // Windows / macOS 推荐
    auto-route: true,
    auto-detect-interface: true,

    // ★ 核心：DNS 劫持（解决 DNS Leak）
    dns-hijack: [
      "any:53",
      "tcp://any:53"
    ]
  };

  // ===== 3. DNS 配置（系统代理 & TUN 通用）=====
  config["dns"] = {
    enable: true,
    listen: "127.0.0.1:1053",        // 本地监听，防误用
    ipv6: false,

    "enhanced-mode": "fake-ip",
    "fake-ip-range": "198.18.0.1/16",

    "fake-ip-filter": [
      "+.lan",
      "+.local",
      "+.direct",
      "+.msftconnecttest.com",
      "+.msftncsi.com",
      "localhost.ptlogin2.qq.com",
      "*stun*"
    ],

    // 系统兜底 DNS（仅启动阶段）
    "default-nameserver": [
      "223.5.5.5",
      "119.29.29.29"
    ],

    // 主 DNS（国内）
    "nameserver": domesticNameservers,

    // fallback → 国外
    "fallback": foreignNameservers,

    "fallback-filter": {
      geoip: true,
      "geoip-code": "CN",
      ipcidr: ["240.0.0.0/4"]
    },

    // DNS 分流策略
    "nameserver-policy": {
      "geosite:cn,private": domesticNameservers,
      "geosite:google,youtube,telegram,openai,github": foreignNameservers
    }
  };

  // ===== 4. 规则集 =====
  const ruleProviders = {
    "reject": {
      ...ruleProviderCommon,
      url: "https://fastly.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/reject.txt",
      path: "./ruleset/reject.yaml"
    },
    "icloud": {
      ...ruleProviderCommon,
      url: "https://fastly.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/icloud.txt",
      path: "./ruleset/icloud.yaml"
    },
    "google": {
      ...ruleProviderCommon,
      url: "https://fastly.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/google.txt",
      path: "./ruleset/google.yaml"
    },
    "proxy": {
      ...ruleProviderCommon,
      url: "https://fastly.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/proxy.txt",
      path: "./ruleset/proxy.yaml"
    },
    "direct": {
      ...ruleProviderCommon,
      url: "https://fastly.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/direct.txt",
      path: "./ruleset/direct.yaml"
    },
    "gfw": {
      ...ruleProviderCommon,
      url: "https://fastly.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/gfw.txt",
      path: "./ruleset/gfw.yaml"
    },
    "telegramcidr": {
      ...ruleProviderCommon,
      behavior: "ipcidr",
      url: "https://fastly.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/telegramcidr.txt",
      path: "./ruleset/telegramcidr.yaml"
    },
    "cncidr": {
      ...ruleProviderCommon,
      behavior: "ipcidr",
      url: "https://fastly.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/cncidr.txt",
      path: "./ruleset/cncidr.yaml"
    }
  };

  // ===== 5. 代理组 =====
  const groupBase = {
    interval: 300,
    url: "https://www.google.com/generate_204",
    lazy: true
  };

  config["proxy-groups"] = [
    {
      ...groupBase,
      name: "节点选择",
      type: "select",
      proxies: ["自动选择", "故障转移"],
      "include-all": true
    },
    {
      ...groupBase,
      name: "自动选择",
      type: "url-test",
      tolerance: 100,
      "include-all": true
    },
    {
      ...groupBase,
      name: "故障转移",
      type: "fallback",
      "include-all": true
    },
    {
      ...groupBase,
      name: "Telegram",
      type: "select",
      proxies: ["节点选择", "自动选择", "全局直连"]
    },
    {
      ...groupBase,
      name: "AI",
      type: "select",
      proxies: ["节点选择", "自动选择"]
    },
    {
      ...groupBase,
      name: "YouTube",
      type: "select",
      proxies: ["节点选择", "自动选择"]
    },
    {
      ...groupBase,
      name: "广告过滤",
      type: "select",
      proxies: ["REJECT", "DIRECT"]
    },
    {
      ...groupBase,
      name: "全局直连",
      type: "select",
      proxies: ["DIRECT", "节点选择"]
    },
    {
      ...groupBase,
      name: "漏网之鱼",
      type: "select",
      proxies: ["节点选择", "自动选择", "DIRECT"]
    }
  ];

  // ===== 6. 规则 =====
  config["rule-providers"] = ruleProviders;
  config["rules"] = [
    "RULE-SET,reject,广告过滤",
    "RULE-SET,telegramcidr,Telegram,no-resolve",
    "RULE-SET,google,节点选择",
    "RULE-SET,icloud,DIRECT",
    "RULE-SET,proxy,节点选择",
    "RULE-SET,gfw,节点选择",
    "RULE-SET,direct,DIRECT",
    "RULE-SET,cncidr,DIRECT,no-resolve",
    "GEOIP,LAN,DIRECT,no-resolve",
    "GEOIP,CN,DIRECT,no-resolve",
    "MATCH,漏网之鱼"
  ];

  // ===== 7. UDP 全开 =====
  if (config["proxies"]) {
    config["proxies"].forEach(p => p.udp = true);
  }

  return config;
}
