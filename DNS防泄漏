// ================= 配置区 =================

// 国内 DNS（DoH）
const domesticNameservers = [
  "https://223.5.5.5/dns-query",
  "https://doh.pub/dns-query"
];

// 国外 DNS（DoH），加上 #RULES 强制这部分 DNS 解析走代理分流，防止泄露
const foreignNameserversWithRules = [
  "https://1.1.1.1/dns-query#RULES",
  "https://8.8.8.8/dns-query#RULES",
  "https://dns.google/dns-query#RULES"
];

// ★ 抖音 & 字节系相关域名（用于 fake-ip 白名单 + 强制直连）
// 这些域名很多涉及视频流/长连接/风控校验，在 fake-ip 下容易连接失败或被判定异常
const douyinDomains = [
  "douyin.com",
  "iesdouyin.com",
  "amemv.com",
  "snssdk.com",
  "toutiao.com",
  "ixigua.com",
  "pstatp.com",
  "zijieapi.com",
  "bytedance.com",
  "bytedns.com",
  "bytedanceapi.com",
  "byteimg.com",
  "douyinpic.com",
  "douyinvod.com"
];

// 规则集通用配置
const ruleProviderCommon = {
  type: "http",
  format: "yaml",
  interval: 86400,
  behavior: "domain"
};

// ================= 主逻辑 =================
function main(config) {

  // ===== 1. 基础性能 & 指纹 =====
  config["tcp-concurrent"] = true;
  config["unified-delay"] = true;
  config["global-client-fingerprint"] = "chrome";

  // ===== 2. TUN 配置（DNS 强制接管）=====
  config["tun"] = {
    enable: true,
    stack: "system",
    "auto-route": true,
    "auto-detect-interface": true,
    "strict-route": true, // 保持严格路由抓取漏网之鱼
    // ★ 关键修复：不接管 IPv6 路由。之前抖音连接 IPv6 地址报
    // "unreachable network"，就是因为 TUN 抢了 IPv6 默认路由，
    // 但网卡本身没做实际的 IPv6 转发，导致所有 IPv6 连接直接失败。
    // 关掉后 IPv6 流量交还给系统网络栈，走原生路由。
    "ipv6": false,
    "dns-hijack": [
      "any:53",
      "tcp://any:53"
    ],
    // ★ 让抖音进程的流量完全不经过 TUN/Mihomo 用户态重新拨号，
    // 直接走系统原生网络栈，避免 TCP/TLS 指纹异常被风控拦截。
    // 已根据任务管理器确认 Windows 下实际进程名为 douyin.exe
    // 注：从连接日志看这个内核版本似乎没有真正生效（流量仍被 TUN 抓到），
    // 保留此字段无害，实际生效靠下面的 PROCESS-NAME 规则兜底
    "exclude-process-name": [
      "douyin.exe"
    ]
  };

  // ===== 3. DNS（防泄露极致版配置）=====
  config["dns"] = {
    enable: true,
    listen: "127.0.0.1:1053",
    ipv6: false,

    "enhanced-mode": "fake-ip",
    "fake-ip-range": "198.18.0.1/16",
    "fake-ip-filter": [
      "+.lan",
      "+.local",
      "localhost.ptlogin2.qq.com",
      "+.msftconnecttest.com",
      "+.msftncsi.com",
      "*stun*",
      // ★ 抖音相关域名走真实 DNS，不用 fake-ip，避免视频流/风控校验失败
      ...douyinDomains.map(d => `+.${d}`)
    ],

    "default-nameserver": [
      "119.29.29.29",
      "223.5.5.5"
    ],

    "nameserver-policy": {
      "geosite:cn,private,apple": domesticNameservers,
      // ★ 抖音域名强制走国内 DNS 解析，拿到真实的国内 CDN IP
      [douyinDomains.map(d => `+.${d}`).join(",")]: domesticNameservers
    },

    "nameserver": foreignNameserversWithRules,

    "proxy-server-nameserver": [
      "119.29.29.29",
      "223.5.5.5"
    ],

    "direct-nameserver": domesticNameservers
  };

  // ===== 4. 规则集 =====
  const ruleProviders = {
    reject: {
      ...ruleProviderCommon,
      url: "https://fastly.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/reject.txt",
      path: "./ruleset/reject.yaml"
    },
    icloud: {
      ...ruleProviderCommon,
      url: "https://fastly.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/icloud.txt",
      path: "./ruleset/icloud.yaml"
    },
    google: {
      ...ruleProviderCommon,
      url: "https://fastly.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/google.txt",
      path: "./ruleset/google.yaml"
    },
    openai: {
      ...ruleProviderCommon,
      url: "https://fastly.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/openai.txt",
      path: "./ruleset/openai.yaml"
    },
    proxy: {
      ...ruleProviderCommon,
      url: "https://fastly.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/proxy.txt",
      path: "./ruleset/proxy.yaml"
    },
    direct: {
      ...ruleProviderCommon,
      url: "https://fastly.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/direct.txt",
      path: "./ruleset/direct.yaml"
    },
    gfw: {
      ...ruleProviderCommon,
      url: "https://fastly.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/gfw.txt",
      path: "./ruleset/gfw.yaml"
    },
    telegramcidr: {
      ...ruleProviderCommon,
      behavior: "ipcidr",
      url: "https://fastly.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/telegramcidr.txt",
      path: "./ruleset/telegramcidr.yaml"
    },
    cncidr: {
      ...ruleProviderCommon,
      behavior: "ipcidr",
      url: "https://fastly.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/cncidr.txt",
      path: "./ruleset/cncidr.yaml"
    }
  };

  // ===== 5. 代理组 =====
  const groupBase = {
    interval: 300,
    url: "https://www.google.com/generate_204",
    lazy: true
  };

  config["proxy-groups"] = [
    {
      ...groupBase,
      name: "专属定制",
      type: "select",
      proxies: ["DIRECT"],
      "include-all": true,
      // 加词边界，避免 "us" 误中 Russia / Belarus / Mauritius 等节点名
      filter: "(?i)美国|(^|[^a-zA-Z])us([^a-zA-Z]|$)|united states|洛杉矶|硅谷|波特兰|西雅图|los angeles|san jose"
    },
    {
      ...groupBase,
      name: "节点选择",
      type: "select",
      proxies: ["自动选择", "故障转移"],
      "include-all": true
    },
    {
      ...groupBase,
      name: "自动选择",
      type: "url-test",
      tolerance: 100,
      "include-all": true
    },
    {
      ...groupBase,
      name: "故障转移",
      type: "fallback",
      "include-all": true
    },
    {
      ...groupBase,
      name: "Telegram",
      type: "select",
      proxies: ["节点选择", "自动选择", "DIRECT"]
    },
    {
      ...groupBase,
      name: "AI",
      type: "select",
      proxies: ["节点选择", "自动选择"]
    },
    {
      ...groupBase,
      name: "YouTube",
      type: "select",
      proxies: ["节点选择", "自动选择"]
    },
    {
      ...groupBase,
      name: "广告过滤",
      type: "select",
      proxies: ["REJECT", "DIRECT"]
    },
    {
      ...groupBase,
      name: "全局直连",
      type: "select",
      proxies: ["DIRECT", "节点选择"]
    },
    {
      ...groupBase,
      name: "漏网之鱼",
      type: "select",
      proxies: ["节点选择", "自动选择", "DIRECT"]
    }
  ];

  // ===== 6. 规则（顺序关键）=====
  config["rule-providers"] = ruleProviders;
  config["rules"] = [
    "RULE-SET,reject,广告过滤",

    // ★ 双保险：按进程名强制直连（部分内核版本对 exclude-process-name 支持不完整，
    // PROCESS-NAME 规则作为兜底，已确认 Windows 实际进程名为 douyin.exe）
    "PROCESS-NAME,douyin.exe,DIRECT",

    // ★ 抖音/字节系强制直连，放在最前面，不依赖 GEOSITE 判断，
    // 避免因为规则集未覆盖导致误判进代理组，被风控掐断连接
    ...douyinDomains.map(d => `DOMAIN-SUFFIX,${d},DIRECT`),

    // ★ X (Twitter) 相关的域名全部强行送入"专属定制"代理组
    "DOMAIN-SUFFIX,x.com,专属定制",
    "DOMAIN-SUFFIX,twitter.com,专属定制",
    "DOMAIN-SUFFIX,twimg.com,专属定制",
    "DOMAIN-SUFFIX,t.co,专属定制",

    "RULE-SET,telegramcidr,Telegram,no-resolve",
    "RULE-SET,openai,AI",

    // AI 服务
    "DOMAIN-SUFFIX,openai.com,AI",
    "DOMAIN-SUFFIX,claude.ai,AI",
    "DOMAIN-SUFFIX,anthropic.com,AI",
    "DOMAIN-KEYWORD,openai,AI",

    // YouTube
    "DOMAIN-SUFFIX,youtube.com,YouTube",
    "DOMAIN-SUFFIX,googlevideo.com,YouTube",
    "DOMAIN-SUFFIX,ytimg.com,YouTube",

    "RULE-SET,google,节点选择",
    "RULE-SET,icloud,DIRECT",
    "RULE-SET,proxy,节点选择",
    "RULE-SET,gfw,节点选择",
    "RULE-SET,direct,DIRECT",

    // 明确要求国内域名走直连
    "GEOSITE,CN,DIRECT",

    // 让 Clash 遇到纯 IP 请求时也能正确判断是否为国内
    "RULE-SET,cncidr,DIRECT",
    "GEOIP,LAN,DIRECT,no-resolve",
    "GEOIP,CN,DIRECT",

    "MATCH,漏网之鱼"
  ];

  // ===== 7. UDP 全开 =====
  if (config["proxies"]) {
    config["proxies"].forEach(p => p.udp = true);
  }

  return config;
}
